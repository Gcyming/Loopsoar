{
  "name": "loopsoar",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "gen": "pnpm --filter loopsoar-contracts gen",
    "check": "pnpm --filter loopsoar-contracts check",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "bundle:shell": "node scripts/bundle-shell.mjs",
    "ext:keygen": "tsx scripts/extension-sign.ts keygen",
    "ext:sign": "tsx scripts/extension-sign.ts sign",
    "ext:verify": "tsx scripts/extension-sign.ts verify",
    "market:keygen": "tsx scripts/market-publish.ts keygen",
    "market:build": "tsx scripts/market-publish.ts build",
    "market:sign": "tsx scripts/market-publish.ts sign",
    "market:verify": "tsx scripts/market-publish.ts verify",
    "e2e:extension": "node scripts/e2e-extension-run.mjs",
    "dev": "node scripts/dev-gui.mjs",
    "dev:gui": "node scripts/dev-gui.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6",
    "zod": "^3.23",
    "vitest": "^2.1",
    "@types/node": "^24",
    "tsx": "^4",
    "react": "^19.1",
    "react-dom": "^19.1",
    "@types/react": "^19.2",
    "vite": "^6.3",
    "@vitejs/plugin-react": "^5",
    "esbuild": "^0.25.0",
    "electron": "^45.0.0",
    "fastify": "^5",
    "@fastify/cors": "^10"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
