{
  "name": "loopsoar-gateway",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./main": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "dependencies": {
    "loopsoar-services": "workspace:*",
    "fastify": "^5",
    "@fastify/cors": "^10"
  },
  "devDependencies": {
    "typescript": "^5.6",
    "@types/node": "^24"
  }
}
