{
  "name": "loopsoar-contracts",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": "./dist/src/index.js",
    "./ipc": "./dist/gen/ipc.js",
    "./schemas": "./dist/src/schemas.js",
    "./extension": "./dist/src/extension.js",
    "./extensionRegistry": "./dist/src/extensionRegistry.js",
    "./layout": "./dist/src/layout.js",
    "./navigation": "./dist/src/navigation.js",
    "./security-policy": "./dist/src/security-policy.js",
    "./omnibox": "./dist/src/omnibox.js",
    "./headerTemplate": "./dist/src/headerTemplate.js"
  },
  "scripts": {
    "gen": "tsx scripts/gen-cli.ts",
    "check": "tsx scripts/check.ts",
    "build": "node ../../scripts/clean-dist.mjs dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^3.23"
  },
  "devDependencies": {
    "tsx": "^4"
  },
  "publishConfig": {
    "access": "public"
  }
}
